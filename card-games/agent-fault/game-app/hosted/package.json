{
  "name": "agent-fault-live-hosted",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "description": "AGENT/FAULT LIVE · isolated online multiplayer edition",
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "check": "node --check lib/game.mjs && node --check public/static/app.js",
    "build": "node scripts/build-unified.mjs",
    "cloudflare:check": "node --check cloudflare/src/index.mjs && node --check ../cloudflare/shared/room-adapter.mjs && node --check public/static/room-realtime.mjs",
    "cloudflare:dry-run": "wrangler deploy --dry-run",
    "cloudflare:deploy": "wrangler deploy",
    "unified:check": "node --test tests/unified-app.test.mjs",
    "quality:check": "node scripts/comedy-audit.mjs",
    "balance:check": "node scripts/balance-audit.mjs"
  },
  "dependencies": {
    "@netlify/database": "latest",
    "@netlify/functions": "latest",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  }
}
